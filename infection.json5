{
  "$schema": "vendor/infection/infection/resources/schema.json",
  "source": {
    "directories": [
      "src/Rfc9421"
    ],
  },
  "timeout": 10,
  "threads": "auto",
  "logs": {
    "text": "build/logs/infection.log",
    "summary": "build/logs/infection-summary.log",
    "json": "build/logs/infection.json",
    "html": "build/logs/infection.html",
    "stryker": {
      "badge": "main"
    }
  },
  "tmpDir": "build/cache/infection",
  "minMsi": 99,
  "minCoveredMsi": 99,
  "mutators": {
    "@default": true,
  },
  "timeoutsAsEscaped": true,
  "maxTimeouts": 10,
}
