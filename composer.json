{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "filefabrik/rfc9421",
  "description": "Create and validate RFC 9421 HTTP Signatures for ActivityPub.",
  "homepage": "https://filefabrik.com/rfc9421-http-signatures-activity-pub",
  "license": "proprietary",
  "keywords": [
    "activity pub",
    "ActivityPub",
    "HTTP Signatures",
    "RFC9421",
    "HTTP Message Signing and Verification"
  ],
  "authors": [
    {
      "name": "RT Filefabrik",
      "email": "rt@filefabrik.com",
      "homepage": "https://filefabrik.com",
      "role": "Maintainer"
    }
  ],
  "minimum-stability": "stable",
  "type": "library",
  "autoload": {
    "psr-4": {
      "Filefabrik\\Rfc9421\\": "src/Rfc9421"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Filefabrik\\Rfc9421Test\\": "tests/Rfc9421",
      "Filefabrik\\Rfc9421Test\\Tools\\": "tests/Tools",
      "Filefabrik\\Rfc9421Test\\Prepared\\": "tests/Prepared",
      "Filefabrik\\Rfc9421Test\\Examples\\": "examples/"
    }
  },
  "require": {
    "php": "^8.4|^8.5",
    "psr/http-message": "^2.0",
    "bakame/http-structured-fields": "^2.0",
    "ext-openssl": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "*",
    "friendsofphp/php-cs-fixer": "^v3.95.24",
    "phpstan/phpstan": "^2.3",
    "phpstan/phpstan-strict-rules": "^2.0.7",
    "phpstan/phpstan-phpunit": "^2.0.8",
    "phpstan/phpstan-deprecation-rules": "^2.0.3",
    "guzzlehttp/guzzle": "^8.2.0",
    "paragonie/easy-ecc": "^v1.3.1",
    "phpseclib/phpseclib": "~4.0",
    "rector/rector": "^2.7",
    "symfony/http-foundation": "^v8.1.8",
    "symfony/psr-http-message-bridge": "^v8.1.0",
    "nyholm/psr7": "^1.8",
    "roave/security-advisories": "dev-latest",
    "infection/infection": "^0.35"
  },
  "readme": "",
  "prefer-stable": true,
  "time": "",
  "support": {},
  "config": {
    "allow-plugins": {
      "infection/extension-installer": true
    }
  },
  "scripts": {
    "analyze": "vendor/bin/phpstan analyze --ansi -v --memory-limit=1G",

    "coverage-ci": "XDEBUG_MODE=coverage phpunit --colors=always --testdox --coverage-text --coverage-clover ./.coverage/clover.xml",
    "mutation": "XDEBUG_MODE=coverage vendor/bin/infection --show-mutations=max",
    "test": "vendor/bin/phpunit --colors=always"
  }
}
